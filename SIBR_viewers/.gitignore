# extlibs: ignore all downloaded / cloned dependencies, EXCEPT the two libraries
# we modified locally and vendor directly in this repo (imgui, CudaRasterizer).
extlibs/*
!extlibs/CudaRasterizer/
!extlibs/imgui/
!extlibs/VENDORED_LIBS.md
extlibs/CudaRasterizer/*
!extlibs/CudaRasterizer/CudaRasterizer/
extlibs/imgui/*
!extlibs/imgui/imgui/
# still exclude their build output / trimmed sub-trees
extlibs/CudaRasterizer/CudaRasterizer/build/
extlibs/CudaRasterizer/build/
extlibs/CudaRasterizer/subbuild/
extlibs/imgui/imgui/build/
extlibs/imgui/build/
extlibs/imgui/subbuild/
extlibs/CudaRasterizer/CudaRasterizer/third_party/glm/doc/
extlibs/CudaRasterizer/CudaRasterizer/third_party/glm/test/

build/
install/
src/projects/*
cmake-gui.exe.stackdump
__pycache__/

# emacs garbage
\#*
.\#*

# vim garbage
*.swp
*.swo
*.idea/
*.log
*.sh
*.tmp

hs_err_*

# re include common public projects
!src/projects/ulr/
!src/projects/dataset_tools/
!src/projects/gaussianviewer/
!src/projects/basic/
!src/projects/remote/

# more vim garbage
# Swap
[._]*.s[a-v][a-z]
!*.svg  # comment out if you don't need vector files
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]

# Session
Session.vim
Sessionx.vim

# Temporary
.netrwhist
*~
# Auto-generated tag files
tags
# Persistent undo
[._]*.un~